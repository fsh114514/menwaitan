# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data (chat logs)
/data/

# local screenshots
/.shots/
/tmp-frames/

# gh cli config written into workspace
/.config/
/.local/

# dsh tool artifacts
.dsh-*/

# 参赛材料中的大文件
competition/video/*.mp4
competition/video/*.mov
competition/screenshots/_raw/

# 文书导出的中间产物
competition/docs/pdf/*.html

# 参赛材料与私人交接文档：只留在本地分支，不进公开仓库
competition/
会话交接-门外谈.md
